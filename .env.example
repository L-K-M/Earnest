# Earnest deployment settings — copy to `.env` and adjust. docker compose reads
# `.env` automatically; update.sh warns when it is missing.
#
# Database password. The compose default "earnest" is a zero-config dev value —
# set a real one for any deployment (openssl rand -hex 32). Both services read
# this same variable, so changing it here keeps them in sync.
EARNEST_DB_PASSWORD=

# Host port the app is published on (container always listens on 8080).
#EARNEST_PORT=8080
# Host port for sandboxed article content.
#EARNEST_CONTENT_PORT=8081

# Postgres is published on the host for tooling (psql, migrations) — loopback
# only by default. Widen the bind or change the host port if needed.
#EARNEST_DB_BIND=127.0.0.1
#EARNEST_DB_PORT=5432

# Bind-mount for the database instead of the managed `pgdata` volume.
#EARNEST_DB_VOLUME=/srv/earnest/pgdata

#EARNEST_LOG_LEVEL=info

# App secret: required, at least 32 bytes. Generate with openssl rand -hex 32.
# Protect this value and retain it with backups; changing it prevents decrypting
# stored credentials. Never put it in source control.
EARNEST_SECRET_KEY=

# Direct binary use requires a Postgres DSN. Compose builds its own from the
# database password above, unless EARNEST_DATABASE_URL overrides it.
#EARNEST_DATABASE_URL=postgres://earnest:password@localhost:5432/earnest
# Direct binary listen address; Compose keeps the container on :8080.
#EARNEST_HTTP_ADDR=:8080
#EARNEST_CONTENT_ADDR=:8081
# Public app origin and a DIFFERENT origin for sandboxed article frames.
# Set the content origin to the address the browser uses, including its port.
# Provision routing/TLS for both when deploying the web UI.
#EARNEST_BASE_URL=http://localhost:8080
#EARNEST_CONTENT_ORIGIN=http://localhost:8081
# Explicit private egress destinations only. Empty means none.
#EARNEST_OUTBOUND_ALLOW_PRIVATE=ollama:11434,ntfy:80
# Go durations; positive and min <= max. The initial feed interval is one hour.
#EARNEST_FETCH_MIN_INTERVAL=15m
#EARNEST_FETCH_MAX_INTERVAL=24h
#EARNEST_RETENTION_DAYS=90

# Nightly backup retention and optional absolute host directory.
#EARNEST_BACKUP_KEEP=14
#EARNEST_BACKUP_VOLUME=/srv/earnest/backups

# Push transports (direct binary environment; pass through a Compose override
# when using containers). ntfy destinations are per-user API settings.
# Web Push and UnifiedPush share VAPID keys. Set BOTH overrides, with a PEM
# PKCS#8 P-256 private key (actual newlines) and base64url public point, or leave
# both unset to generate and store a pair on first startup.
#EARNEST_PUSH_VAPID_PRIVATE_KEY=
#EARNEST_PUSH_VAPID_PUBLIC_KEY=
# Optional mailto: or https: contact for push providers.
#EARNEST_PUSH_VAPID_SUBJECT=mailto:reader@example.com
# Generated keys default to earnest/vapid.json in the OS user config directory.
# Back up the file; mount persistent storage for it in containers. Set this
# path instead of explicit key overrides, never together with them.
#EARNEST_PUSH_VAPID_KEY_FILE=/srv/earnest/vapid.json

# APNs is disabled unless all three settings are present. The private key is
# the PEM PKCS#8 .p8 contents (actual newlines). Never commit signing keys.
#EARNEST_APNS_PRIVATE_KEY=
#EARNEST_APNS_KEY_ID=
#EARNEST_APNS_TEAM_ID=
#EARNEST_APNS_SANDBOX=false
