# Copy to .env. Generate separate random values, for example: openssl rand -hex 32
# Compose's database fallback is earnest; set a strong value for deployment.
EARNEST_DB_PASSWORD=
# Required: at least 32 bytes. Preserve with backups.
EARNEST_SECRET_KEY=

# Compose defaults; changing a password does not update an existing database.
#EARNEST_DATABASE_URL=postgres://earnest:password@postgres:5432/earnest
#EARNEST_DB_VOLUME=pgdata
#EARNEST_BACKUP_VOLUME=backups
#EARNEST_BACKUP_KEEP=14
#EARNEST_LOG_LEVEL=info
#EARNEST_PORT=8080
#EARNEST_CONTENT_PORT=8081
#EARNEST_DB_BIND=127.0.0.1
#EARNEST_DB_PORT=5432
# Direct binary defaults; Compose fixes the container listeners at these ports.
#EARNEST_HTTP_ADDR=:8080
#EARNEST_CONTENT_ADDR=:8081
#EARNEST_BASE_URL=http://localhost:8080
#EARNEST_CONTENT_ORIGIN=http://localhost:8081
#EARNEST_OUTBOUND_ALLOW_PRIVATE=
# Comma-separated IPs/CIDRs of reverse proxies, beyond loopback, whose
# X-Forwarded-For identifies the client for login rate limits. Behind
# tailscale serve on the Compose host, set the Docker network gateway
# (see docs/operations.md).
#EARNEST_TRUSTED_PROXIES=
#EARNEST_FETCH_MIN_INTERVAL=15m
#EARNEST_FETCH_MAX_INTERVAL=24h
#EARNEST_FETCH_CACHE_MAX_INTERVAL=48h
# Entry and change-log retention: 1 to 106751 whole days.
#EARNEST_RETENTION_DAYS=90

# CLI defaults (set in the CLI's environment when running outside Compose).
#EARNEST_URL=http://127.0.0.1:8080
#EARNEST_TOKEN=

# Push defaults: empty keys generate a pair in the OS user config directory.
# Persist that directory or provide an explicit pair. PEM values need newlines.
#EARNEST_PUSH_VAPID_PRIVATE_KEY=
#EARNEST_PUSH_VAPID_PUBLIC_KEY=
#EARNEST_PUSH_VAPID_SUBJECT=
#EARNEST_PUSH_VAPID_KEY_FILE=
#EARNEST_APNS_PRIVATE_KEY=
#EARNEST_APNS_KEY_ID=
#EARNEST_APNS_TEAM_ID=
#EARNEST_APNS_SANDBOX=false

# LLM: off by default. Replace LOCAL with a provider name and configure both
# KIND and BASE_URL. A zero limit means unlimited. Model prices use a JSON overlay.
#EARNEST_LLM_PROVIDER_LOCAL_KIND=openai
#EARNEST_LLM_PROVIDER_LOCAL_BASE_URL=http://ollama:11434/v1
#EARNEST_LLM_PROVIDER_LOCAL_API_KEY=
#EARNEST_LLM_PROVIDER_LOCAL_LIMIT_USD=0
#EARNEST_LLM_PROVIDER_LOCAL_TIMEOUT=60s
#EARNEST_LLM_PROVIDER_LOCAL_TOKEN_FIELD=max_completion_tokens
#EARNEST_LLM_MODELS={}
# Tasks are disabled by default. Set provider and model together. Task names:
# EMBED, CLASSIFY, BLURB, SUMMARY, EDITION, COMPILE_RULE, ASK.
#EARNEST_LLM_TASK_EMBED_PROVIDER=local
#EARNEST_LLM_TASK_EMBED_MODEL=bge-m3
#EARNEST_LLM_TASK_CLASSIFY_PROVIDER=
#EARNEST_LLM_TASK_CLASSIFY_MODEL=
#EARNEST_LLM_TASK_BLURB_PROVIDER=
#EARNEST_LLM_TASK_BLURB_MODEL=
#EARNEST_LLM_TASK_SUMMARY_PROVIDER=
#EARNEST_LLM_TASK_SUMMARY_MODEL=
#EARNEST_LLM_TASK_EDITION_PROVIDER=
#EARNEST_LLM_TASK_EDITION_MODEL=
#EARNEST_LLM_TASK_COMPILE_RULE_PROVIDER=
#EARNEST_LLM_TASK_COMPILE_RULE_MODEL=
#EARNEST_LLM_TASK_ASK_PROVIDER=
#EARNEST_LLM_TASK_ASK_MODEL=
