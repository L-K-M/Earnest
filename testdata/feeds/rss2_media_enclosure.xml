<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>Image enclosure</title>
    <link>https://example.com/</link>
    <item>
      <title>JPEG enclosure</title>
      <link>https://example.com/jpg</link>
      <guid>jpg-1</guid>
      <enclosure url="https://cdn.example.com/photo.jpg" type="image/jpeg" length="10"/>
    </item>
    <item>
      <title>Audio enclosure is not an image</title>
      <link>https://example.com/audio</link>
      <guid>audio-1</guid>
      <enclosure url="https://cdn.example.com/audio.mp3" type="audio/mpeg" length="10"/>
    </item>
    <item>
      <title>First valid image enclosure wins</title>
      <link>https://example.com/first</link>
      <guid>first-1</guid>
      <enclosure url="https://cdn.example.com/pic.svg" type="image/svg+xml" length="1"/>
      <enclosure url="https://cdn.example.com/pic.png" type="image/png" length="1"/>
    </item>
  </channel>
</rss>
