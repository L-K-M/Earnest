{
  "version": 1,
  "name": "source-ranks",
  "decision": "Source outranks clocks for stale writes. Tokens, including agent tokens claiming explicit operations, determine source; agents cannot become deliberate.",
  "setup": [
    {
      "op": "ingest",
      "entry": {
        "id": 1,
        "subscription_id": 1
      },
      "expect": {
        "id": 1,
        "seq": 1,
        "rev": 1
      }
    },
    {
      "op": "write",
      "write": {
        "op_id": "human-unread",
        "entry_id": 1,
        "register": "seen",
        "value": "unseen"
      },
      "at": "2026-11-01T12:00:00Z",
      "expect": {
        "status": "applied"
      }
    }
  ],
  "operations": [
    {
      "op": "write",
      "write": {
        "op_id": "scroll",
        "entry_id": 1,
        "register": "seen",
        "value": "seen",
        "kind": "passive"
      },
      "expect": {
        "status": "superseded"
      }
    },
    {
      "op": "write",
      "write": {
        "op_id": "agent",
        "entry_id": 1,
        "register": "seen",
        "value": "seen"
      },
      "token": "agent",
      "actor": 9,
      "expect": {
        "status": "superseded"
      }
    },
    {
      "op": "write",
      "write": {
        "op_id": "rule",
        "entry_id": 1,
        "register": "seen",
        "value": "seen"
      },
      "token": "rule",
      "actor": 8,
      "expect": {
        "status": "superseded"
      }
    }
  ],
  "final": [
    {
      "op": "assert_state",
      "entry_id": 1,
      "expect": {
        "state": {
          "seen": {
            "value": "unseen"
          },
          "shelf": {
            "value": "none"
          },
          "kept": {
            "value": false
          }
        },
        "unread": true
      }
    },
    {
      "op": "assert_state",
      "entry_id": 1,
      "expect": {
        "state": {
          "seen": {
            "source": "deliberate",
            "actor": 1
          }
        }
      }
    }
  ]
}
