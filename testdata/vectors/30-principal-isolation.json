{
  "version": 1,
  "name": "principal-isolation",
  "decision": "Registers belong to the target principal; provenance and op_id deduplication belong to the authenticated actor. Agent and human progress remain separate.",
  "setup": [
    {
      "op": "ingest",
      "entry": {
        "id": 1,
        "subscription_id": 1
      },
      "expect": {
        "id": 1,
        "seq": 1,
        "rev": 1
      }
    }
  ],
  "operations": [
    {
      "op": "write",
      "write": {
        "op_id": "same-id",
        "entry_id": 1,
        "register": "seen",
        "value": "seen",
        "principal": 9
      },
      "actor": 9,
      "token": "agent",
      "expect": {
        "status": "applied"
      }
    },
    {
      "op": "write",
      "write": {
        "op_id": "same-id",
        "entry_id": 1,
        "register": "seen",
        "value": "unseen"
      },
      "expect": {
        "status": "applied"
      }
    },
    {
      "op": "write",
      "write": {
        "op_id": "human-target",
        "entry_id": 1,
        "register": "seen",
        "value": "seen",
        "principal": 1
      },
      "actor": 9,
      "token": "agent",
      "expect": {
        "status": "superseded"
      }
    }
  ],
  "final": [
    {
      "op": "assert_state",
      "entry_id": 1,
      "expect": {
        "state": {
          "seen": {
            "value": "unseen"
          },
          "shelf": {
            "value": "none"
          },
          "kept": {
            "value": false
          }
        },
        "unread": true
      }
    },
    {
      "op": "assert_state",
      "entry_id": 1,
      "principal": 9,
      "expect": {
        "state": {
          "seen": {
            "value": "seen"
          },
          "shelf": {
            "value": "none"
          },
          "kept": {
            "value": false
          }
        },
        "unread": false
      }
    },
    {
      "op": "assert_state",
      "entry_id": 1,
      "principal": 9,
      "expect": {
        "state": {
          "seen": {
            "actor": 9,
            "source": "rule_or_agent"
          }
        }
      }
    },
    {
      "op": "assert_log",
      "expect": {
        "rev": 3
      }
    }
  ]
}
