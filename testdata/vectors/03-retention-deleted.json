{
  "version": 1,
  "name": "retention-deleted",
  "decision": "Gone wins over queue expiry. A retained tombstone never resurrects an entry or its state.",
  "setup": [
    {
      "op": "ingest",
      "entry": {
        "id": 1,
        "subscription_id": 1
      },
      "expect": {
        "id": 1,
        "seq": 1,
        "rev": 1
      }
    },
    {
      "op": "bootstrap_begin",
      "device": "phone",
      "expect": {
        "generation": "g1"
      }
    },
    {
      "op": "bootstrap_page",
      "device": "phone",
      "expect": {}
    },
    {
      "op": "client_pull",
      "device": "phone",
      "expect": {
        "generation": "g1"
      }
    }
  ],
  "operations": [
    {
      "op": "client_queue",
      "device": "phone",
      "write": {
        "op_id": "queued",
        "entry_id": 1,
        "register": "seen",
        "value": "seen"
      },
      "expect": {}
    },
    {
      "op": "delete",
      "entry_id": 1,
      "expect": {}
    },
    {
      "op": "client_flush",
      "device": "phone",
      "expect": [
        {
          "status": "gone"
        }
      ]
    },
    {
      "op": "client_pull",
      "device": "phone",
      "expect": {}
    }
  ],
  "final": [
    {
      "op": "assert_entry",
      "entry_id": 1,
      "device": "phone",
      "expect": {
        "entry": {
          "deleted": true
        }
      }
    },
    {
      "op": "assert_client",
      "device": "phone",
      "expect": {
        "outbox_size": 0
      }
    },
    {
      "op": "assert_state",
      "entry_id": 1,
      "expect": {
        "state": {
          "seen": {
            "value": "unseen"
          },
          "shelf": {
            "value": "none"
          },
          "kept": {
            "value": false
          }
        },
        "unread": true
      }
    }
  ]
}
