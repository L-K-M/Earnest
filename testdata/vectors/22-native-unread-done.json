{
  "version": 1,
  "name": "native-unread-done",
  "decision": "Accepting native unseen clears Done atomically with matching provenance. A rejected passive action cannot clear the shelf.",
  "setup": [
    {
      "op": "ingest",
      "entry": {
        "id": 1,
        "subscription_id": 1
      },
      "expect": {
        "id": 1,
        "seq": 1,
        "rev": 1
      }
    },
    {
      "op": "write",
      "write": {
        "op_id": "done",
        "entry_id": 1,
        "register": "shelf",
        "value": "done"
      },
      "expect": {
        "status": "applied"
      }
    }
  ],
  "operations": [
    {
      "op": "write",
      "write": {
        "op_id": "unread",
        "entry_id": 1,
        "register": "seen",
        "value": "unseen"
      },
      "expect": {
        "status": "applied"
      }
    },
    {
      "op": "write",
      "write": {
        "op_id": "passive",
        "entry_id": 1,
        "register": "seen",
        "value": "seen",
        "kind": "passive"
      },
      "expect": {
        "status": "superseded"
      }
    }
  ],
  "final": [
    {
      "op": "assert_state",
      "entry_id": 1,
      "expect": {
        "state": {
          "seen": {
            "value": "unseen"
          },
          "shelf": {
            "value": "none"
          },
          "kept": {
            "value": false
          }
        },
        "unread": true
      }
    },
    {
      "op": "assert_state",
      "entry_id": 1,
      "expect": {
        "state": {
          "seen": {
            "rev": 3
          },
          "shelf": {
            "rev": 3,
            "source": "deliberate"
          }
        }
      }
    },
    {
      "op": "assert_log",
      "expect": {
        "types": [
          "entry.created",
          "state.updated",
          "state.updated"
        ]
      }
    }
  ]
}
