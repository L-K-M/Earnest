{
  "version": 1,
  "name": "repeated-operation",
  "decision": "Remembered op_ids return current effective state, preserving the original outcome and adding replay=true. They do not re-enter conflict resolution after bootstrap.",
  "setup": [
    {
      "op": "ingest",
      "entry": {
        "id": 1,
        "subscription_id": 1
      },
      "expect": {
        "id": 1,
        "seq": 1,
        "rev": 1
      }
    },
    {
      "op": "write",
      "write": {
        "op_id": "original",
        "entry_id": 1,
        "register": "seen",
        "value": "seen"
      },
      "expect": {
        "status": "applied"
      }
    }
  ],
  "operations": [
    {
      "op": "write",
      "write": {
        "op_id": "newer",
        "entry_id": 1,
        "register": "seen",
        "value": "unseen"
      },
      "expect": {
        "status": "applied"
      }
    },
    {
      "op": "bootstrap_begin",
      "device": "phone",
      "expect": {
        "generation": "g1"
      }
    },
    {
      "op": "bootstrap_page",
      "device": "phone",
      "expect": {}
    },
    {
      "op": "client_pull",
      "device": "phone",
      "expect": {
        "generation": "g1"
      }
    },
    {
      "op": "write",
      "write": {
        "op_id": "original",
        "entry_id": 1,
        "register": "seen",
        "value": "seen"
      },
      "expect": {
        "status": "applied",
        "replay": true,
        "state": {
          "seen": {
            "value": "unseen",
            "rev": 3
          }
        }
      }
    }
  ],
  "final": [
    {
      "op": "assert_state",
      "entry_id": 1,
      "expect": {
        "state": {
          "seen": {
            "value": "unseen"
          },
          "shelf": {
            "value": "none"
          },
          "kept": {
            "value": false
          }
        },
        "unread": true
      }
    },
    {
      "op": "assert_state",
      "entry_id": 1,
      "device": "phone",
      "expect": {
        "state": {
          "seen": {
            "value": "unseen"
          },
          "shelf": {
            "value": "none"
          },
          "kept": {
            "value": false
          }
        },
        "unread": true
      }
    },
    {
      "op": "assert_log",
      "expect": {
        "rev": 3,
        "count": 3
      }
    }
  ]
}
