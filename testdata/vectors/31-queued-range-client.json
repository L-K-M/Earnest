{
  "version": 1,
  "name": "queued-range-client",
  "decision": "Ranges remain first-class outbox items with a fixed through_seq and original action time. Re-bootstrap preserves them; a 29-day range loses to newer unreads and a 31-day range expires, with both overlays removed after acknowledgement.",
  "setup": [
    {
      "op": "ingest",
      "entry": {
        "id": 1,
        "subscription_id": 1
      },
      "expect": {
        "id": 1,
        "seq": 1,
        "rev": 1
      }
    },
    {
      "op": "write",
      "write": {
        "op_id": "unread",
        "entry_id": 1,
        "register": "seen",
        "value": "unseen"
      },
      "at": "2026-11-01T12:00:00Z",
      "expect": {
        "status": "applied"
      }
    },
    {
      "op": "bootstrap_begin",
      "device": "phone",
      "expect": {
        "generation": "g1"
      }
    },
    {
      "op": "bootstrap_page",
      "device": "phone",
      "expect": {}
    },
    {
      "op": "client_pull",
      "device": "phone",
      "expect": {
        "generation": "g1"
      }
    }
  ],
  "operations": [
    {
      "op": "client_queue_range",
      "device": "phone",
      "write": {
        "op_id": "queued-29",
        "occurred_at": "2026-10-04T12:00:00Z"
      },
      "scope": {
        "kind": "all"
      },
      "through_seq": 1,
      "expect": {}
    },
    {
      "op": "assert_state",
      "entry_id": 1,
      "device": "phone",
      "expect": {
        "state": {
          "seen": {
            "value": "seen"
          },
          "shelf": {
            "value": "none"
          },
          "kept": {
            "value": false
          }
        },
        "unread": false
      }
    },
    {
      "op": "bootstrap_begin",
      "device": "phone",
      "expect": {
        "generation": "g1"
      }
    },
    {
      "op": "bootstrap_page",
      "device": "phone",
      "expect": {}
    },
    {
      "op": "client_pull",
      "device": "phone",
      "expect": {
        "generation": "g1"
      }
    },
    {
      "op": "client_flush",
      "device": "phone",
      "expect": [
        {
          "status": "applied",
          "except": [
            1
          ],
          "results": [
            {
              "status": "superseded"
            }
          ]
        }
      ]
    },
    {
      "op": "client_queue_range",
      "device": "phone",
      "write": {
        "op_id": "queued-31",
        "occurred_at": "2026-10-02T12:00:00Z"
      },
      "scope": {
        "kind": "all"
      },
      "through_seq": 1,
      "expect": {}
    },
    {
      "op": "client_flush",
      "device": "phone",
      "expect": [
        {
          "status": "expired",
          "results": []
        }
      ]
    }
  ],
  "final": [
    {
      "op": "assert_state",
      "entry_id": 1,
      "expect": {
        "state": {
          "seen": {
            "value": "unseen"
          },
          "shelf": {
            "value": "none"
          },
          "kept": {
            "value": false
          }
        },
        "unread": true
      }
    },
    {
      "op": "assert_state",
      "entry_id": 1,
      "device": "phone",
      "expect": {
        "state": {
          "seen": {
            "value": "unseen"
          },
          "shelf": {
            "value": "none"
          },
          "kept": {
            "value": false
          }
        },
        "unread": true
      }
    },
    {
      "op": "assert_client",
      "device": "phone",
      "expect": {
        "outbox_size": 0
      }
    }
  ]
}
