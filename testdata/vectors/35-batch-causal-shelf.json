{
  "version": 1,
  "name": "batch-causal-shelf",
  "decision": "An unread item may reset Done within its batch. A later explicit shelf intent in that same event is causal, not a concurrent device write, and can set Done again. This prevents one device from conflicting with its own implied shelf write.",
  "setup": [
    {
      "op": "ingest",
      "entry": {
        "id": 1,
        "subscription_id": 1
      },
      "expect": {
        "id": 1,
        "seq": 1,
        "rev": 1
      }
    },
    {
      "op": "write",
      "write": {
        "op_id": "done",
        "entry_id": 1,
        "register": "shelf",
        "value": "done"
      },
      "expect": {
        "status": "applied"
      }
    },
    {
      "op": "bootstrap_begin",
      "device": "phone",
      "expect": {
        "generation": "g1"
      }
    },
    {
      "op": "bootstrap_page",
      "device": "phone",
      "expect": {}
    },
    {
      "op": "client_pull",
      "device": "phone",
      "expect": {
        "generation": "g1"
      }
    }
  ],
  "operations": [
    {
      "op": "client_queue",
      "device": "phone",
      "write": {
        "op_id": "unread",
        "entry_id": 1,
        "register": "seen",
        "value": "unseen"
      },
      "expect": {}
    },
    {
      "op": "client_queue",
      "device": "phone",
      "write": {
        "op_id": "done-again",
        "entry_id": 1,
        "register": "shelf",
        "value": "done",
        "base_rev": {
          "generation": "g1",
          "rev": 2
        }
      },
      "expect": {}
    },
    {
      "op": "client_flush",
      "device": "phone",
      "expect": [
        {
          "op_id": "unread",
          "status": "applied"
        },
        {
          "op_id": "done-again",
          "status": "applied"
        }
      ]
    }
  ],
  "final": [
    {
      "op": "assert_state",
      "entry_id": 1,
      "expect": {
        "state": {
          "seen": {
            "value": "unseen"
          },
          "shelf": {
            "value": "done"
          },
          "kept": {
            "value": false
          }
        },
        "unread": false
      }
    },
    {
      "op": "assert_state",
      "entry_id": 1,
      "device": "phone",
      "expect": {
        "state": {
          "seen": {
            "value": "unseen"
          },
          "shelf": {
            "value": "done"
          },
          "kept": {
            "value": false
          }
        },
        "unread": false
      }
    },
    {
      "op": "assert_log",
      "expect": {
        "rev": 3,
        "types": [
          "entry.created",
          "state.updated",
          "state.updated"
        ]
      }
    }
  ]
}
