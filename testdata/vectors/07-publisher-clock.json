{
  "version": 1,
  "name": "publisher-clock",
  "decision": "Publication timestamps never drive ordering or decay. Age is clamped at zero before first_seen_at and otherwise uses elapsed receipt time.",
  "setup": [
    {
      "op": "ingest",
      "at": "2026-11-01T12:00:00Z",
      "entry": {
        "id": 1,
        "subscription_id": 1,
        "published_at": "2030-01-01T00:00:00Z"
      },
      "expect": {
        "seq": 1
      }
    },
    {
      "op": "ingest",
      "entry": {
        "id": 2,
        "subscription_id": 1,
        "published_at": "2020-01-01T00:00:00Z"
      },
      "expect": {
        "seq": 2
      }
    }
  ],
  "operations": [],
  "final": [
    {
      "op": "assert_entry",
      "entry_id": 1,
      "expect": {
        "entry": {
          "seq": 1
        },
        "age_seconds": 86400
      }
    },
    {
      "op": "assert_entry",
      "entry_id": 2,
      "expect": {
        "entry": {
          "seq": 2
        },
        "age_seconds": 0
      }
    },
    {
      "op": "assert_entry",
      "entry_id": 1,
      "at": "2026-10-31T12:00:00Z",
      "expect": {
        "age_seconds": 0
      }
    },
    {
      "op": "assert_state",
      "entry_id": 1,
      "expect": {
        "state": {
          "seen": {
            "value": "unseen"
          },
          "shelf": {
            "value": "none"
          },
          "kept": {
            "value": false
          }
        },
        "unread": true
      }
    },
    {
      "op": "assert_state",
      "entry_id": 2,
      "expect": {
        "state": {
          "seen": {
            "value": "unseen"
          },
          "shelf": {
            "value": "none"
          },
          "kept": {
            "value": false
          }
        },
        "unread": true
      }
    }
  ]
}
