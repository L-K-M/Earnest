<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds trust system CAs only and never send cleartext. Debuggable
     builds also trust user-installed CAs, so you can test against a local
     server with a self-signed certificate (see docs/android.md). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
